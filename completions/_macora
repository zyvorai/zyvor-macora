#compdef macora
_macora() {
  local -a cmds opts ifaces
  cmds=(interactive repl tui topology report resolve show explain routes path dns services wifi neighbors sockets doctor diagnose ping trace watch snapshot diff subnet probe set completions)
  opts=(all up down list compact ipv4 ipv6 raw json redact html md prometheus apply from interface group count interval timeout format theme color speed quick strict to)
  ifaces=(${(z)$(macora list 2>/dev/null)})
  case $words[CURRENT-1] in
    format) compadd -- table json ndjson md html prometheus; return;;
    theme) compadd -- default mono high-contrast; return;;
    color) compadd -- auto always never; return;;
    group) compadd -- Network Bridges Virtual Tunnels System Loopback; return;;
    from) _files; return;;
    to) return;;
    interface|explain|set) compadd -- $ifaces; return;;
  esac
  if (( CURRENT == 2 )); then
    compadd -- $cmds $opts $ifaces
  else
    compadd -- $opts $ifaces
  fi
}
_macora "$@"
