#compdef macora
_arguments -s \
  '1:command:(interactive repl tui topology report resolve show explain routes path dns services wifi neighbors sockets doctor diagnose ping trace watch snapshot diff subnet probe set completions)' \
  '--all' \
  '--up' \
  '--interface[value]:value:' \
  '--group[Interface group]:group:(Network Bridges Virtual Tunnels System Loopback)' \
  '--ipv4' \
  '--ipv6' \
  '--compact' \
  '--json' \
  '--format[Output format]:format:(table json ndjson md html prometheus)' \
  '--redact' \
  '--from[Saved ifconfig capture]:capture:_files' \
  '--color[Color policy]:mode:(auto always never)' \
  '--no-color' \
  '--interval[value]:value:' \
  '--count[value]:value:' \
  '--timeout-ms[value]:value:' \
  '--apply' \
  '--theme[TUI theme]:theme:(default mono high-contrast)' \
  '--help' \
  '--version' \
  '*:argument:_files'
