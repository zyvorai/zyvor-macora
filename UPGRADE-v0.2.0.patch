+++ b/src/session.rs
@@ -0,0 +1,477 @@
+//! A persistent, shell-free exploration session. Inputs are parsed as arguments,
+//! not shell programs. Settings only create a pending plan until explicit apply.
+use crate::{
+    cli, collect, explore, insight,
+    model::Snapshot,
+    parse,
+    view::{self, Filter, Theme},
+};
+use std::{
+    collections::BTreeMap,
+    fs::OpenOptions,
+    io::{self, BufRead, IsTerminal, Write},
+};
+
+pub const HELP: &str = "MACORA Interactive · commands
+  show / ls / 1       Grouped interfaces from the current session capture
+  select NAME         Focus an interface; select all clears focus
+  detail / 2          Explain the selected interface
+  filter TEXT         Filter by name, label, address or group; blank clears
+  all                 Toggle expanded system/tunnel groups
+  family 4|6|all      Select address family
+  doctor / 3          Local findings
+  topology / 4        Observed bridge relationships
+  refresh / r         Reload live source or the offline capture
+  baseline            Remember the current capture
+  changes / 5         Compare the baseline with current capture
+  report              Markdown evidence from this session
+  export FILE         Create private JSON from this session (never overwrite)
+  redact on|off       Toggle IP/MAC masking for displayed/exported records
+  plan up|down        Preview selected interface admin state
+  plan mtu NUMBER     Preview selected interface MTU
+  apply               Apply the pending plan, only after explicit confirmation
+  cancel              Discard pending plan
+  routes / dns / wifi / services / neighbors / path / sockets
+  subnet CIDR / probe IP:PORT / resolve HOST
+  history / !NUMBER   Recall a session command; history is memory-only
+  help / ? / menu     Show this menu
+  quit / q / exit     End session; EOF also exits
+
+Changes to selection, filters or source invalidate pending plans. Offline sessions
+cannot apply settings. No shell expansion, pipes or embedded shell commands run.";
+#[derive(Clone, Debug, Default)]
+pub struct Pending {
+    pub args: Vec<String>,
+}
+pub struct Session {
+    pub snapshot: Snapshot,
+    pub baseline: Snapshot,
+    pub source: Option<String>,
+    pub selected: Option<String>,
+    pub query: String,
+    pub all: bool,
+    pub family: Option<u8>,
+    pub redact: bool,
+    pub history: Vec<String>,
+    pub pending: Option<Pending>,
+}
+pub enum Response {
+    Text(String),
+    Exit,
+    External(Vec<String>),
+    Apply(Vec<String>),
+    Export(String, String),
+}
+impl Session {
+    pub fn new(snapshot: Snapshot, source: Option<String>) -> Self {
+        Self {
+            baseline: snapshot.clone(),
+            snapshot,
+            source,
+            selected: None,
+            query: String::new(),
+            all: false,
+            family: None,
+            redact: false,
+            history: vec![],
+            pending: None,
+        }
+    }
+    pub fn filtered(&self) -> Snapshot {
+        let q = self.query.to_lowercase();
+        let mut s = self.snapshot.clone();
+        s.interfaces.retain(|i| {
+            self.selected.as_ref().map(|n| n == &i.name).unwrap_or(true)
+                && (q.is_empty()
+                    || format!(
+                        "{} {} {} {}",
+                        i.name,
+                        i.label(),
+                        i.group(),
+                        i.addresses
+                            .iter()
+                            .map(|a| a.ip.clone())
+                            .collect::<Vec<_>>()
+                            .join(" ")
+                    )
+                    .to_lowercase()
+                    .contains(&q))
+        });
+        s
+    }
+    pub fn display(&self, text: String) -> String {
+        if self.redact {
+            view::redact(text, &self.snapshot)
+        } else {
+            text
+        }
+    }
+    pub fn execute(&mut self, input: &str, color: bool) -> Result<Response, String> {
+        let mut words = split(input)?;
+        if words.is_empty() {
+            return Ok(Response::Text(String::new()));
+        }
+        if words[0].starts_with('!') {
+            if words.len() != 1 {
+                return Err("Use !NUMBER by itself".into());
+            }
+            let index: usize = words[0][1..]
+                .parse()
+                .map_err(|_| "Use !NUMBER from history")?;
+            let old = self
+                .history
+                .get(index.checked_sub(1).ok_or("History begins at 1")?)
+                .ok_or("No such history item")?
+                .clone();
+            words = split(&old)?;
+            // Never let history recall authorize a mutation.
+            if words.first().map(String::as_str) == Some("apply") {
+                return Err(
+                    "Type apply explicitly; mutation authorization cannot come from history".into(),
+                );
+            }
+        }
+        if words[0] != "history" {
+            self.history.push(input.into());
+            if self.history.len() > 500 {
+                self.history.remove(0);
+            }
+        }
+        let arg = |n: usize| words.get(n).map(String::as_str).ok_or("Missing argument");
+        let mut output = match words[0].as_str() {
+            "quit" | "q" | "exit" => return Ok(Response::Exit),
+            "help" | "?" | "menu" => HELP.into(),
+            "show" | "ls" | "1" => view::interfaces(
+                &self.filtered(),
+                &Filter {
+                    all: self.all,
+                    interface: self.selected.clone(),
+                    family: self.family,
+                    ..Default::default()
+                },
+                &Theme { color },
+                &BTreeMap::new(),
+            ),
+            "select" => {
+                let n = arg(1)?;
+                if n == "all" {
+                    self.selected = None;
+                } else {
+                    if !self.snapshot.interfaces.iter().any(|i| i.name == n) {
+                        return Err("Unknown interface".into());
+                    }
+                    self.selected = Some(n.into());
+                }
+                self.pending = None;
+                format!("Selection: {}", self.selected.as_deref().unwrap_or("all"))
+            }
+            "filter" => {
+                self.query = words[1..].join(" ");
+                self.pending = None;
+                format!("Filter: {}", self.query)
+            }
+            "all" => {
+                self.all = !self.all;
+                self.pending = None;
+                format!("Expand all groups: {}", self.all)
+            }
+            "family" => {
+                self.family = match arg(1)? {
+                    "4" => Some(4),
+                    "6" => Some(6),
+                    "all" => None,
+                    _ => return Err("Choose family 4, 6, or all".into()),
+                };
+                self.pending = None;
+                "Address filter updated".into()
+            }
+            "detail" | "2" => {
+                let selected = self.selected.as_ref().ok_or("Use select NAME first")?;
+                let i = self
+                    .snapshot
+                    .interfaces
+                    .iter()
+                    .find(|i| &i.name == selected)
+                    .ok_or("Selected interface disappeared")?;
+                insight::explain(i)
+            }
+            "doctor" | "3" => insight::findings(&self.snapshot).join("\n"),
+            "topology" | "4" => explore::topology(&self.snapshot, false),
+            "baseline" => {
+                self.baseline = self.snapshot.clone();
+                self.pending = None;
+                "Baseline captured for this session.".into()
+            }
+            "changes" | "5" => {
+                let d = insight::diff(&self.baseline, &self.snapshot);
+                if d.is_empty() {
+                    "No configuration changes from baseline.".into()
+                } else {
+                    d.join("\n")
+                }
+            }
+            "report" => explore::report(&self.snapshot, false),
+            "redact" => {
+                self.redact = match arg(1)? {
+                    "on" => true,
+                    "off" => false,
+                    _ => return Err("Use redact on|off".into()),
+                };
+                format!("IP/MAC masking: {}", self.redact)
+            }
+            "refresh" | "r" => {
+                let s = load(self.source.as_deref())?;
+                self.replace(s);
+                "Capture refreshed; pending plan discarded.".into()
+            }
+            "history" => self
+                .history
+                .iter()
+                .enumerate()
+                .map(|(n, s)| format!("{}  {}", n + 1, s))
+                .collect::<Vec<_>>()
+                .join("\n"),
+            "plan" => {
+                self.pending = None;
+                let selected = self.selected.as_ref().ok_or("Use select NAME first")?;
+                let mut command = vec!["set".into(), selected.clone()];
+                command.extend(words[1..].iter().cloned());
+                let plan = cli::set_plan(&command, &self.snapshot)?;
+                let preview = format!(
+                    "Preview: /sbin/ifconfig {}\nThis can disconnect this Mac. {}",
+                    plan.join(" "),
+                    if self.source.is_some() {
+                        "OFFLINE: application is disabled."
+                    } else {
+                        "Type apply, then confirm the exact command. Privileges must already be available."
+                    }
+                );
+                self.pending = Some(Pending { args: plan });
+                preview
+            }
+            "cancel" => {
+                self.pending = None;
+                "Pending plan discarded.".into()
+            }
+            "apply" => {
+                if words.len() != 1 {
+                    return Err("Type apply by itself".into());
+                }
+                if self.source.is_some() {
+                    return Err("Offline captures cannot authorize settings changes".into());
+                }
+                if !cfg!(target_os = "macos") {
+                    return Err("Applying settings requires macOS".into());
+                }
+                let plan = self
+                    .pending
+                    .take()
+                    .ok_or("No pending plan; use plan first")?;
+                return Ok(Response::Apply(plan.args));
+            }
+            "export" => {
+                if words.len() != 2 {
+                    return Err("Use export FILE (quote paths containing spaces)".into());
+                }
+                return Ok(Response::Export(
+                    words[1].clone(),
+                    self.display(self.snapshot.json()),
+                ));
+            }
+            "routes" | "dns" | "wifi" | "services" | "neighbors" | "path" | "sockets" => {
+                if self.source.is_some() {
+                    return Err("Live system inspectors are disabled in an offline session".into());
+                }
+                return Ok(Response::External(words));
+            }
+            "subnet" | "probe" | "resolve" => {
+                if words[0] != "subnet" && self.source.is_some() {
+                    return Err("Network operations are disabled in an offline session".into());
+                }
+                return Ok(Response::External(words));
+            }
+            _ => {
+                return Err(
+                    "Unknown command; type help or menu. Shell syntax is not supported.".into(),
+                )
+            }
+        };
+        if self.redact {
+            output = view::redact(output, &self.baseline);
+            output = self.display(output);
+        }
+        Ok(Response::Text(output))
+    }
+    pub fn replace(&mut self, s: Snapshot) {
+        self.snapshot = s;
+        self.pending = None;
+        if self
+            .selected
+            .as_ref()
+            .map(|n| !self.snapshot.interfaces.iter().any(|i| &i.name == n))
+            .unwrap_or(false)
+        {
+            self.selected = None;
+        }
+    }
+}
+pub fn split(input: &str) -> Result<Vec<String>, String> {
+    let mut out = Vec::new();
+    let mut current = String::new();
+    let mut quote = None;
+    let mut escape = false;
+    let mut started = false;
+    for c in input.chars() {
+        if escape {
+            current.push(c);
+            escape = false;
+            started = true;
+            continue;
+        }
+        if c == '\\' && quote != Some('\'') {
+            escape = true;
+            started = true;
+            continue;
+        }
+        if let Some(q) = quote {
+            if c == q {
+                quote = None;
+            } else {
+                current.push(c);
+            }
+            continue;
+        }
+        match c {
+            '\'' | '"' => {
+                quote = Some(c);
+                started = true;
+            }
+            c if c.is_whitespace() => {
+                if started {
+                    out.push(std::mem::take(&mut current));
+                    started = false;
+                }
+            }
+            '|' | ';' | '`' | '>' => {
+                return Err("Shell operators are not supported".into());
+            }
+            _ => {
+                current.push(c);
+                started = true;
+            }
+        }
+    }
+    if quote.is_some() || escape {
+        return Err("Unclosed quote or escape".into());
+    }
+    if started {
+        out.push(current);
+    }
+    Ok(out)
+}
+pub fn load(source: Option<&str>) -> Result<Snapshot, String> {
+    match source {
+        Some(p) => {
+            let text = std::fs::read_to_string(p).map_err(|e| e.to_string())?;
+            if text.len() > 8 * 1024 * 1024 {
+                return Err("Capture exceeds 8 MiB".into());
+            }
+            parse::ifconfig(&text)
+        }
+        None => collect::snapshot(),
+    }
+}
+pub fn run(source: Option<String>, color: bool, redact: bool, all: bool) -> Result<(), String> {
+    let mut session = Session::new(load(source.as_deref())?, source);
+    session.redact = redact;
+    session.all = all;
+    let tty = io::stdin().is_terminal();
+    let theme = Theme { color };
+    println!(
+        "{}\n{}\n{}",
+        theme.title("MACORA · Interactive network workspace"),
+        if session.source.is_some() {
+            "OFFLINE CAPTURE · network operations and apply disabled"
+        } else {
+            "LIVE SOURCE · read-only until an explicit plan is confirmed"
+        },
+        HELP
+    );
+    let stdin = io::stdin();
+    let mut input = stdin.lock();
+    let mut line = String::new();
+    loop {
+        if tty {
+            print!(
+                "{} ",
+                theme.paint(
+                    "1;36",
+                    &format!("macora[{}] ›", session.selected.as_deref().unwrap_or("all"))
+                )
+            );
+            io::stdout().flush().map_err(|e| e.to_string())?;
+        }
+        line.clear();
+        if input.read_line(&mut line).map_err(|e| e.to_string())? == 0 {
+            break;
+        }
+        match session.execute(line.trim_end(), color) {
+            Ok(Response::Exit) => break,
+            Ok(Response::Text(s)) => {
+                if !s.is_empty() {
+                    println!("{s}");
+                }
+            }
+            Ok(Response::External(args)) => {
+                if let Err(e) = cli::run(args) {
+                    eprintln!("{}", theme.paint("93", &e));
+                }
+            }
+            Ok(Response::Export(path, text)) => {
+                let mut options = OpenOptions::new();
+                options.write(true).create_new(true);
+                #[cfg(unix)]
+                {
+                    use std::os::unix::fs::OpenOptionsExt;
+                    options.mode(0o600);
+                }
+                match options
+                    .open(&path)
+                    .and_then(|mut f| f.write_all(text.as_bytes()))
+                {
+                    Ok(_) => println!("Saved {}", view::safe(&path)),
+                    Err(e) => eprintln!("Export failed: {e}"),
+                }
+            }
+            Ok(Response::Apply(args)) => {
+                if !tty {
+                    eprintln!("Interactive application requires a terminal; plan discarded.");
+                    continue;
+                }
+                let exact = format!("APPLY /sbin/ifconfig {}", args.join(" "));
+                println!("Type exactly: {exact}");
+                let mut confirmation = String::new();
+                input
+                    .read_line(&mut confirmation)
+                    .map_err(|e| e.to_string())?;
+                if confirmation.trim() == exact {
+                    // Revalidate plan against fresh live inventory immediately before execution.
+                    let mut words = vec!["set".to_string()];
+                    words.extend(args);
+                    words.push("--apply".into());
+                    if let Err(e) = cli::run(words) {
+                        eprintln!("Apply failed: {}", view::safe(&e));
+                    }
+                    match load(None) {
+                        Ok(s) => session.replace(s),
+                        Err(e) => eprintln!("Refresh failed: {}", view::safe(&e)),
+                    }
+                } else {
+                    println!("Cancelled; no command executed.");
+                }
+            }
+            Err(e) => eprintln!("{}", theme.paint("93", &e)),
+        }
+    }
+    Ok(())
+}
diff --git a/src/tui.rs b/src/tui.rs
new file mode 100644
index 0000000..1f6c4ab
--- /dev/null
+++ b/src/tui.rs
@@ -0,0 +1,667 @@
+//! Dependency-free terminal dashboard: pure state/rendering plus a thin tty adapter.
+use crate::{
+    explore, insight,
+    model::Snapshot,
+    session,
+    view::{self, Theme},
+};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    io::{self, IsTerminal, Read, Write},
+    process::{Command, Stdio},
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc, Arc,
+    },
+    time::{Duration, Instant},
+};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Tab {
+    Overview,
+    Interfaces,
+    Detail,
+    Topology,
+    Diagnostics,
+    Changes,
+}
+impl Tab {
+    pub fn title(self) -> &'static str {
+        match self {
+            Self::Overview => "Overview",
+            Self::Interfaces => "Interfaces",
+            Self::Detail => "Detail",
+            Self::Topology => "Topology",
+            Self::Diagnostics => "Diagnostics",
+            Self::Changes => "Changes",
+        }
+    }
+}
+pub struct Dashboard {
+    pub session: session::Session,
+    pub tab: Tab,
+    pub index: usize,
+    pub scroll: usize,
+    pub paused: bool,
+    pub help: bool,
+    pub entry: Option<char>,
+    pub input: String,
+    pub status: String,
+    pub favorites: BTreeSet<String>,
+    pub sort: u8,
+    pub rates: BTreeMap<String, (f64, f64)>,
+    pub traffic: Vec<f64>,
+}
+impl Dashboard {
+    pub fn new(s: Snapshot, source: Option<String>) -> Self {
+        Self {
+            session: session::Session::new(s, source),
+            tab: Tab::Overview,
+            index: 0,
+            scroll: 0,
+            paused: false,
+            help: false,
+            entry: None,
+            input: String::new(),
+            status: "Ready. ? help, : command palette, / search".into(),
+            favorites: BTreeSet::new(),
+            sort: 0,
+            rates: BTreeMap::new(),
+            traffic: vec![],
+        }
+    }
+    pub fn names(&self) -> Vec<String> {
+        let q = self.session.query.to_lowercase();
+        let mut items: Vec<_> = self
+            .session
+            .snapshot
+            .interfaces
+            .iter()
+            .filter(|i| {
+                (self.session.all || !["System", "Loopback", "Tunnels"].contains(&i.group()))
+                    && (q.is_empty()
+                        || format!(
+                            "{} {} {} {}",
+                            i.name,
+                            i.label(),
+                            i.group(),
+                            i.addresses
+                                .iter()
+                                .map(|a| a.ip.clone())
+                                .collect::<Vec<_>>()
+                                .join(" ")
+                        )
+                        .to_lowercase()
+                        .contains(&q))
+            })
+            .collect();
+        items.sort_by(|a, b| {
+            let pinned =
+                (!self.favorites.contains(&a.name)).cmp(&(!self.favorites.contains(&b.name)));
+            if pinned != std::cmp::Ordering::Equal {
+                return pinned;
+            }
+            match self.sort {
+                1 => a.name.cmp(&b.name),
+                2 => b.mtu.cmp(&a.mtu).then(a.name.cmp(&b.name)),
+                _ => b.active().cmp(&a.active()).then(a.name.cmp(&b.name)),
+            }
+        });
+        items.into_iter().map(|i| i.name.clone()).collect()
+    }
+    pub fn selected(&self) -> Option<String> {
+        self.names().get(self.index).cloned()
+    }
+    pub fn ingest(&mut self, s: Snapshot, seconds: f64) {
+        self.rates = view::rates(&self.session.snapshot, &s, seconds);
+        let values: Vec<_> = s
+            .interfaces
+            .iter()
+            .filter(|i| i.group() == "Network")
+            .filter_map(|i| self.rates.get(&i.name))
+            .collect();
+        if !values.is_empty() {
+            self.traffic.push(values.iter().map(|(a, b)| a + b).sum());
+            if self.traffic.len() > 60 {
+                self.traffic.remove(0);
+            }
+        }
+        let selected = self.selected();
+        self.session.replace(s);
+        self.index = selected
+            .and_then(|n| self.names().iter().position(|i| i == &n))
+            .unwrap_or(0);
+    }
+    pub fn action(&mut self, input: &str) -> Result<(), String> {
+        let cmd = input.trim().to_lowercase();
+        self.scroll = 0;
+        match cmd.as_str(){
+            "overview"|"home"=>self.tab=Tab::Overview,"interfaces"|"network"=>self.tab=Tab::Interfaces,
+            "detail"=>self.tab=Tab::Detail,"topology"=>self.tab=Tab::Topology,"doctor"|"diagnostics"=>self.tab=Tab::Diagnostics,"changes"=>self.tab=Tab::Changes,
+            "pause"=>self.paused= !self.paused,"baseline"=>{self.session.baseline=self.session.snapshot.clone();self.status="Baseline captured; Changes compares configuration, not traffic counters.".into();},
+            "all"=>{self.session.all= !self.session.all;self.index=0;},"redact"=>self.session.redact= !self.session.redact,
+            "help"=>self.help= !self.help,
+            _ if cmd.starts_with("select ")=>{let name=input.trim()[7..].trim();self.session.all=true;self.index=self.names().iter().position(|n|n==name).ok_or("Interface not found")?;self.tab=Tab::Detail;},
+            _=>return Err("Unknown palette action. Try overview, interfaces, topology, doctor, changes, baseline, pause, all, redact.".into()),
+        }
+        Ok(())
+    }
+    pub fn key(&mut self, b: u8) -> bool {
+        if self.entry.is_some() {
+            match b {
+                3 | 27 => {
+                    self.entry = None;
+                    self.input.clear();
+                }
+                10 | 13 => {
+                    let mode = self.entry.take();
+                    let input = std::mem::take(&mut self.input);
+                    if mode == Some('/') {
+                        self.session.query = input;
+                        self.index = 0;
+                        self.scroll = 0;
+                    } else if let Err(e) = self.action(&input) {
+                        self.status = e;
+                    }
+                }
+                8 | 127 => {
+                    self.input.pop();
+                }
+                32..=126 => {
+                    if self.input.len() < 180 {
+                        self.input.push(b as char);
+                    }
+                }
+                _ => {}
+            }
+            return true;
+        }
+        match b {
+            b'q' | 3 | 4 => return false,
+            b'1' => self.tab = Tab::Overview,
+            b'2' => self.tab = Tab::Interfaces,
+            b'3' => self.tab = Tab::Detail,
+            b'4' => self.tab = Tab::Topology,
+            b'5' => self.tab = Tab::Diagnostics,
+            b'6' => self.tab = Tab::Changes,
+            b'\t' => {
+                self.tab = match self.tab {
+                    Tab::Overview => Tab::Interfaces,
+                    Tab::Interfaces => Tab::Detail,
+                    Tab::Detail => Tab::Topology,
+                    Tab::Topology => Tab::Diagnostics,
+                    Tab::Diagnostics => Tab::Changes,
+                    Tab::Changes => Tab::Overview,
+                };
+                self.scroll = 0;
+            }
+            b'j' => {
+                if self.tab == Tab::Interfaces {
+                    self.index = (self.index + 1).min(self.names().len().saturating_sub(1));
+                } else {
+                    self.scroll = self.scroll.saturating_add(1);
+                }
+            }
+            b'k' => {
+                if self.tab == Tab::Interfaces {
+                    self.index = self.index.saturating_sub(1);
+                } else {
+                    self.scroll = self.scroll.saturating_sub(1);
+                }
+            }
+            13 | 10 => {
+                self.tab = Tab::Detail;
+                self.scroll = 0;
+            }
+            b'a' => {
+                self.session.all = !self.session.all;
+                self.index = 0;
+            }
+            b'f' => {
+                if let Some(name) = self.selected() {
+                    if !self.favorites.remove(&name) {
+                        self.favorites.insert(name.clone());
+                    }
+                    self.index = self.names().iter().position(|n| n == &name).unwrap_or(0);
+                }
+            }
+            b's' => self.sort = (self.sort + 1) % 3,
+            b'p' => self.paused = !self.paused,
+            b'b' => {
+                let _ = self.action("baseline");
+            }
+            b'd' => self.tab = Tab::Changes,
+            b'?' => self.help = !self.help,
+            b'/' | b':' => {
+                self.entry = Some(b as char);
+                self.input.clear();
+            }
+            _ => {}
+        }
+        true
+    }
+    pub fn render(&self, width: usize, height: usize, color: bool) -> String {
+        let width = width.clamp(30, 240);
+        let height = height.clamp(8, 100);
+        let theme = Theme { color };
+        let names = self.names();
+        let mode = if self.session.source.is_some() {
+            "OFFLINE"
+        } else {
+            "LIVE"
+        };
+        let mut lines: Vec<(String, String)> = vec![
+            (
+                "1;96".into(),
+                format!(
+                    "MACORA  /  {}  /  {}{}",
+                    self.tab.title(),
+                    mode,
+                    if self.paused { " · PAUSED" } else { "" }
+                ),
+            ),
+            (
+                "90".into(),
+                "1 Overview   2 Interfaces   3 Detail   4 Topology   5 Diagnostics   6 Changes"
+                    .into(),
+            ),
+            (
+                "90".into(),
+                format!(
+                    "{} interfaces · {} visible · filter {:?} · sort {} · {}",
+                    self.session.snapshot.interfaces.len(),
+                    names.len(),
+                    self.session.query,
+                    ["active", "name", "MTU"][self.sort as usize],
+                    if self.session.redact {
+                        "IP/MAC MASKED"
+                    } else {
+                        "unmasked"
+                    }
+                ),
+            ),
+            ("90".into(), "─".repeat(width)),
+        ];
+        let mut body: Vec<(String, String)> = Vec::new();
+        if self.help {
+            for line in ["KEYBOARD WORKSPACE","j/k or arrows: move/scroll · Enter: interface detail · Tab: next page","/: filter · : command palette · f: favorite · s: sort · a: include system links","p: pause/resume · r: refresh now · b: baseline · d: changes · ?: help · q: quit","Palette: overview, interfaces, detail, topology, doctor, changes, baseline, pause, all, redact","Terminal mode never applies settings. Use macora interactive for a reviewed mutation.","A tunnel is not proof of a VPN. Link-active is not an internet reachability test."]{body.push(("36".into(),line.into()));}
+        } else {
+            match self.tab {
+                Tab::Overview => {
+                    body.push(("1;97".into(), "Your network. Without the noise.".into()));
+                    body.push((
+                        "37".into(),
+                        format!(
+                            "{} link-active adapters · {} bridge(s) · {} tunnel(s)",
+                            self.session
+                                .snapshot
+                                .interfaces
+                                .iter()
+                                .filter(|i| i.group() == "Network" && i.active())
+                                .count(),
+                            self.session
+                                .snapshot
+                                .interfaces
+                                .iter()
+                                .filter(|i| i.group() == "Bridges")
+                                .count(),
+                            self.session
+                                .snapshot
+                                .interfaces
+                                .iter()
+                                .filter(|i| i.group() == "Tunnels")
+                                .count()
+                        ),
+                    ));
+                    body.push((
+                        "36".into(),
+                        format!(
+                            "Adapter traffic  {}",
+                            sparkline(&self.traffic, width.saturating_sub(20))
+                        ),
+                    ));
+                    if self.traffic.is_empty() {
+                        body.push(("90".into(),"Awaiting two successful byte-counter samples; unavailable data is not estimated.".into()));
+                    }
+                    for i in self
+                        .session
+                        .snapshot
+                        .interfaces
+                        .iter()
+                        .filter(|i| i.group() == "Network")
+                    {
+                        body.push((
+                            if i.active() { "92" } else { "90" }.into(),
+                            format!(
+                                "{}  {}  {}",
+                                i.name,
+                                i.label(),
+                                if i.active() {
+                                    "LINK ACTIVE"
+                                } else {
+                                    "IDLE/DOWN"
+                                }
+                            ),
+                        ));
+                        for a in &i.addresses {
+                            if a.scope() != "link-local" {
+                                body.push(("37".into(), format!("  {} · {}", a.cidr(), a.scope())));
+                            }
+                        }
+                    }
+                    body.push((
+                        "90".into(),
+                        "b captures a baseline. Configuration drift appears on Changes.".into(),
+                    ));
+                }
+                Tab::Interfaces => {
+                    body.push((
+                        "90".into(),
+                        format!(
+                            "  {:<12} {:<12} {:<12} {:<7} {}",
+                            "INTERFACE", "GROUP", "STATE", "MTU", "LABEL"
+                        ),
+                    ));
+                    let viewport = height.saturating_sub(9);
+                    let start = self.index.saturating_sub(viewport.saturating_sub(1));
+                    for (n, name) in names.iter().enumerate().skip(start).take(viewport) {
+                        if let Some(i) = self
+                            .session
+                            .snapshot
+                            .interfaces
+                            .iter()
+                            .find(|i| &i.name == name)
+                        {
+                            body.push((
+                                if n == self.index { "1;96" } else { "37" }.into(),
+                                format!(
+                                    "{}{} {:<12} {:<12} {:<12} {:<7} {}",
+                                    if n == self.index { ">" } else { " " },
+                                    if self.favorites.contains(name) {
+                                        "*"
+                                    } else {
+                                        " "
+                                    },
+                                    i.name,
+                                    i.group(),
+                                    if i.active() {
+                                        "ACTIVE"
+                                    } else if i.up() {
+                                        "IDLE"
+                                    } else {
+                                        "DOWN"
+                                    },
+                                    i.mtu.map(|n| n.to_string()).unwrap_or("?".into()),
+                                    i.label()
+                                ),
+                            ));
+                        }
+                    }
+                    if names.is_empty() {
+                        body.push((
+                            "93".into(),
+                            "No matching interfaces. / clears the filter; a expands system groups."
+                                .into(),
+                        ));
+                    }
+                }
+                Tab::Detail => {
+                    if let Some(i) = self.selected().and_then(|n| {
+                        self.session
+                            .snapshot
+                            .interfaces
+                            .iter()
+                            .find(|i| i.name == n)
+                    }) {
+                        body.push(("1;96".into(), format!("{} / {}", i.name, i.label())));
+                        for a in &i.addresses {
+                            body.push((
+                                "37".into(),
+                                format!("{}  {}  {}", a.cidr(), a.scope(), a.attributes.join(", ")),
+                            ));
+                        }
+                        for line in insight::explain(i).lines() {
+                            body.push(("37".into(), line.into()));
+                        }
+                    } else {
+                        body.push(("93".into(), "Select an interface on tab 2.".into()));
+                    }
+                }
+                Tab::Topology => {
+                    for line in explore::topology(&self.session.snapshot, false).lines() {
+                        body.push(("36".into(), line.into()));
+                    }
+                }
+                Tab::Diagnostics => {
+                    for line in insight::findings(&self.session.snapshot) {
+                        body.push((
+                            if line.starts_with("WARN") { "93" } else { "36" }.into(),
+                            line,
+                        ));
+                    }
+                }
+                Tab::Changes => {
+                    let d = insight::diff(&self.session.baseline, &self.session.snapshot);
+                    if d.is_empty() {
+                        body.push((
+                            "90".into(),
+                            "No configuration changes from baseline. Counters are excluded.".into(),
+                        ));
+                    }
+                    for line in d {
+                        body.push(("33".into(), line));
+                    }
+                }
+            }
+        }
+        let viewport = height.saturating_sub(7);
+        let offset = if self.tab == Tab::Interfaces {
+            0
+        } else {
+            self.scroll.min(body.len().saturating_sub(viewport))
+        };
+        lines.extend(body.into_iter().skip(offset).take(viewport));
+        while lines.len() < height - 3 {
+            lines.push(("37".into(), String::new()));
+        }
+        lines.push(("90".into(), "─".repeat(width)));
+        lines.push(("93".into(), self.status.clone()));
+        lines.push((
+            "36".into(),
+            self.entry
+                .map(|mode| format!("{mode}{}", self.input))
+                .unwrap_or(
+                "/: search   : palette   j/k: move   Enter: detail   p: pause   ?: help   q: exit"
+                    .into(),
+            ),
+        ));
+        lines
+            .into_iter()
+            .take(height)
+            .map(|(code, line)| {
+                let mut line = if self.session.redact {
+                    view::redact(
+                        view::redact(line, &self.session.baseline),
+                        &self.session.snapshot,
+                    )
+                } else {
+                    line
+                };
+                line = view::safe(&line).replace('\n', " ");
+                let line = line.chars().take(width).collect::<String>();
+                theme.paint(&code, &line)
+            })
+            .collect::<Vec<_>>()
+            .join("\r\n")
+    }
+}
+pub fn sparkline(values: &[f64], width: usize) -> String {
+    if values.is_empty() {
+        return "[waiting for samples]".into();
+    }
+    let max = values
+        .iter()
+        .copied()
+        .filter(|n| n.is_finite())
+        .fold(0.0, f64::max)
+        .max(1.0);
+    let glyphs = ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'];
+    values
+        .iter()
+        .skip(values.len().saturating_sub(width))
+        .map(|n| {
+            glyphs[if n.is_finite() {
+                ((n.max(0.0) / max * 7.0).round() as usize).min(7)
+            } else {
+                0
+            }]
+        })
+        .collect()
+}
+fn stty(args: &[&str]) -> Result<String, String> {
+    let program = if cfg!(target_os = "macos") {
+        "/bin/stty"
+    } else {
+        "/usr/bin/stty"
+    };
+    let output = Command::new(program)
+        .args(args)
+        .stdin(Stdio::inherit())
+        .output()
+        .map_err(|e| e.to_string())?;
+    if output.status.success() {
+        Ok(String::from_utf8_lossy(&output.stdout).trim().into())
+    } else {
+        Err(String::from_utf8_lossy(&output.stderr).into())
+    }
+}
+struct Terminal {
+    saved: String,
+}
+impl Terminal {
+    fn enter() -> Result<Self, String> {
+        let saved = stty(&["-g"])?;
+        stty(&["raw", "-echo", "min", "0", "time", "1"])?;
+        let guard = Self { saved };
+        print!("\x1b[?1049h\x1b[?25l");
+        io::stdout().flush().map_err(|e| e.to_string())?;
+        Ok(guard)
+    }
+}
+impl Drop for Terminal {
+    fn drop(&mut self) {
+        let _ = stty(&[&self.saved]);
+        print!("\x1b[0m\x1b[?25h\x1b[?1049l");
+        let _ = io::stdout().flush();
+    }
+}
+pub fn run(
+    source: Option<String>,
+    interval: f64,
+    color: bool,
+    redact: bool,
+    all: bool,
+) -> Result<(), String> {
+    if !io::stdin().is_terminal() || !io::stdout().is_terminal() {
+        return Err(
+            "tui requires an interactive terminal; use interactive for piped sessions".into(),
+        );
+    }
+    let mut app = Dashboard::new(session::load(source.as_deref())?, source);
+    app.session.redact = redact;
+    app.session.all = all;
+    let _terminal = Terminal::enter()?;
+    let running = Arc::new(AtomicBool::new(true));
+    let active = running.clone();
+    let (send, recv) = mpsc::channel();
+    let reader = std::thread::spawn(move || {
+        let mut stdin = io::stdin().lock();
+        let mut b = [0];
+        while active.load(Ordering::Relaxed) {
+            match stdin.read(&mut b) {
+                Ok(1) => {
+                    if send.send(b[0]).is_err() {
+                        break;
+                    }
+                }
+                Ok(_) => {}
+                Err(_) => break,
+            }
+        }
+    });
+    let mut last = Instant::now();
+    let mut last_attempt = last;
+    let mut escape = 0u8;
+    let mut keep = true;
+    let mut force_refresh = false;
+    let result = (|| -> Result<(), String> {
+        while keep {
+            let size = stty(&["size"]).unwrap_or("30 110".into());
+            let parts: Vec<_> = size.split_whitespace().collect();
+            let height = parts.first().and_then(|n| n.parse().ok()).unwrap_or(30);
+            let width = parts.get(1).and_then(|n| n.parse().ok()).unwrap_or(110);
+            print!("\x1b[H\x1b[J{}", app.render(width, height, color));
+            io::stdout().flush().map_err(|e| e.to_string())?;
+            match recv.recv_timeout(Duration::from_millis(100)) {
+                Ok(b) => {
+                    // Arrow keys become the same tested j/k/Tab actions. Escape cancels text input.
+                    if escape == 1 {
+                        if b == b'[' {
+                            escape = 2;
+                            continue;
+                        }
+                        escape = 0;
+                    }
+                    if escape == 2 {
+                        escape = 0;
+                        keep = app.key(match b {
+                            b'A' => b'k',
+                            b'B' => b'j',
+                            b'C' | b'D' => b'\t',
+                            _ => 0,
+                        });
+                        continue;
+                    }
+                    if b == 27 {
+                        if app.entry.is_some() {
+                            app.key(27);
+                        } else {
+                            escape = 1;
+                        }
+                        continue;
+                    }
+                    if b == b'r' && app.entry.is_none() {
+                        force_refresh = true;
+                    }
+                    keep = app.key(b);
+                }
+                Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                Err(mpsc::RecvTimeoutError::Timeout) => {
+                    escape = 0;
+                }
+            }
+            if !keep {
+                break;
+            }
+            if force_refresh
+                || (!app.paused && last_attempt.elapsed() >= Duration::from_secs_f64(interval))
+            {
+                force_refresh = false;
+                last_attempt = Instant::now();
+                match session::load(app.session.source.as_deref()) {
+                    Ok(s) => {
+                        let now = Instant::now();
+                        app.ingest(s, now.duration_since(last).as_secs_f64());
+                        last = now;
+                        app.status =
+                            "Capture refreshed. Link state is not an internet health check.".into();
+                    }
+                    Err(e) => app.status = format!("STALE · refresh failed: {e}"),
+                }
+            }
+        }
+        Ok(())
+    })();
+    running.store(false, Ordering::Relaxed);
+    let _ = reader.join();
+    result
+}
