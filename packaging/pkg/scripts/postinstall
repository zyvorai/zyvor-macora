#!/bin/bash
# Put the bundled command line tool on PATH. Runs as root during pkg installation.
# Installer arguments: $1 package, $2 install location, $3 target volume.
# A convenience link must never make the installation fail, so every problem here is non-fatal.
app="${2:-/Applications}/Macora.app/Contents/Resources/macora"
dest="${3:-/}"
if mkdir -p "$dest/usr/local/bin" 2>/dev/null && ln -sf "$app" "$dest/usr/local/bin/macora" 2>/dev/null; then
  echo "macora linked into $dest/usr/local/bin"
else
  echo "macora: could not create $dest/usr/local/bin/macora (non-fatal); run it from $app"
fi
exit 0
